<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:padding="12dp" android:background="@drawable/widget_classic_shell">
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/widget_classic_screen">
  <ImageView android:id="@+id/widget_art" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_logo" android:contentDescription="Sampul album"/>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="12dp" android:orientation="vertical">
   <TextView android:id="@+id/widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="iSwara / CLASSIC" android:textColor="#C3CEAB" android:textSize="10sp"/>
   <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="iSwara Music" android:textColor="#FFF8E7" android:textSize="16sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
   <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C3CEAB" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
 </LinearLayout>
 <RelativeLayout android:layout_width="144dp" android:layout_height="144dp" android:layout_marginTop="8dp" android:background="@drawable/widget_wheel">
  <TextView android:layout_width="match_parent" android:layout_height="32dp" android:layout_alignParentTop="true" android:layout_marginTop="8dp" android:gravity="center" android:text="MENU" android:textSize="10sp" android:textColor="#716C64"/>
  <ImageButton android:id="@+id/widget_previous" android:layout_width="48dp" android:layout_height="48dp" android:layout_centerVertical="true" android:layout_alignParentStart="true" android:tint="#33332F" android:src="@android:drawable/ic_media_previous" android:background="@android:color/transparent" android:contentDescription="Lagu sebelumnya"/>
  <ImageButton android:id="@+id/widget_toggle" android:layout_width="48dp" android:layout_height="48dp" android:layout_centerInParent="true" android:tint="#33332F" android:src="@android:drawable/ic_media_play" android:background="@android:color/transparent" android:contentDescription="Putar atau jeda"/>
  <ImageButton android:id="@+id/widget_next" android:layout_width="48dp" android:layout_height="48dp" android:layout_centerVertical="true" android:layout_alignParentEnd="true" android:tint="#33332F" android:src="@android:drawable/ic_media_next" android:background="@android:color/transparent" android:contentDescription="Lagu berikutnya"/>
  <TextView android:layout_width="match_parent" android:layout_height="32dp" android:layout_alignParentBottom="true" android:layout_marginBottom="8dp" android:gravity="center" android:text="iSwara" android:textSize="10sp" android:textColor="#716C64"/>
 </RelativeLayout>
</LinearLayout>