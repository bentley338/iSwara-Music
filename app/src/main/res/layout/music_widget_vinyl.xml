<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_shell">
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageView android:id="@+id/widget_art" android:layout_width="96dp" android:layout_height="96dp" android:src="@drawable/ic_vinyl" android:contentDescription="Piringan musik"/>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="16dp">
   <TextView android:id="@+id/widget_brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="iSwara / VINYL" android:textSize="10sp" android:textColor="#FFAB85"/>
   <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="iSwara Music" android:textSize="18sp" android:textStyle="bold" android:textColor="#FAF7F2" android:maxLines="2" android:ellipsize="end"/>
   <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#CAC7C3" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:orientation="horizontal">
  <ImageButton android:id="@+id/widget_previous" android:layout_width="64dp" android:layout_height="48dp" android:src="@android:drawable/ic_media_previous" android:background="@android:color/transparent" android:contentDescription="Lagu sebelumnya"/><ImageButton android:id="@+id/widget_toggle" android:layout_width="64dp" android:layout_height="48dp" android:src="@android:drawable/ic_media_play" android:background="@android:color/transparent" android:contentDescription="Putar atau jeda"/><ImageButton android:id="@+id/widget_next" android:layout_width="64dp" android:layout_height="48dp" android:src="@android:drawable/ic_media_next" android:background="@android:color/transparent" android:contentDescription="Lagu berikutnya"/>
 </LinearLayout>
</LinearLayout>